<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Text-to-SQL Architecture Studio</title>
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --border-color: #1f2937;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --primary: #3b82f6;
            --success: #10b981;
            --danger: #ef4444;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); padding: 20px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; }
        h1 { font-size: 24px; color: var(--primary); }
        .subtitle { font-size: 13px; color: var(--text-muted); }
        
        .header-actions { display: flex; gap: 12px; align-items: center; }
        .ai-tutor-btn { background: linear-gradient(135deg, #8b5cf6, #6366f1); color: #fff; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 13px; }
        .ai-tutor-btn:hover { opacity: 0.9; }

        .grid-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        @media (max-width: 1024px) { .grid-container { grid-template-columns: 1fr; } }

        .card { background-color: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; margin-bottom: 20px; }
        h2 { font-size: 16px; margin-bottom: 12px; color: #93c5fd; display: flex; align-items: center; gap: 8px; }

        textarea, input { width: 100%; background: #030712; border: 1px solid var(--border-color); color: #fff; padding: 12px; border-radius: 8px; font-size: 14px; margin-bottom: 12px; }
        textarea { height: 90px; resize: none; }
        
        .primary-btn { background: var(--primary); color: #fff; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; }
        .primary-btn:hover { opacity: 0.9; }

        .preset-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; }
        .preset-btn { background: #1f2937; color: var(--text-muted); font-size: 11px; padding: 6px 10px; border-radius: 6px; cursor: pointer; border: 1px solid #374151; }
        .preset-btn:hover { background: #374151; color: #fff; }

        .results-box { background: #030712; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; margin-top: 10px; font-family: monospace; font-size: 12px; max-height: 160px; overflow-y: auto; color: #38bdf8; }
        
        #ast-tree-container { background: #030712; border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 8px; overflow-x: auto; }
        .ast-node { background: #1e3a8a; border: 2px solid #60a5fa; color: #fff; padding: 8px 14px; border-radius: 8px; font-size: 11px; font-family: monospace; text-align: center; }
        .ast-node.danger { background: #7f1d1d; border-color: #f87171; }
        .ast-connector { width: 2px; height: 14px; background: #4b5563; }
        .ast-row { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; width: 100%; }

        .badge { padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold; display: inline-block; }
        .badge.safe { background: rgba(16, 185, 129, 0.2); color: var(--success); border: 1px solid var(--success); }
        .badge.danger { background: rgba(239, 68, 68, 0.2); color: var(--danger); border: 1px solid var(--danger); }

        #tutor-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { background: var(--card-bg); border: 1px solid var(--border-color); width: 620px; border-radius: 12px; padding: 25px; position: relative; }
        .close-btn { position: absolute; top: 15px; right: 20px; color: var(--text-muted); font-size: 20px; cursor: pointer; }
        .chat-box { background: #030712; border: 1px solid var(--border-color); height: 280px; border-radius: 8px; padding: 12px; overflow-y: auto; margin-bottom: 12px; font-size: 13px; display: flex; flex-direction: column; gap: 10px; }
        .chat-msg { padding: 10px 14px; border-radius: 8px; max-width: 90%; line-height: 1.5; }
        .chat-msg.user { background: #1e3a8a; align-self: flex-end; color: #fff; }
        .chat-msg.ai { background: #1f2937; align-self: flex-start; color: #e5e7eb; border-left: 3px solid #8b5cf6; }
    </style>
</head>
<body>

    <header>
        <div>
            <h1>Secure Text-to-SQL Architecture Studio</h1>
            <div class="subtitle">LL(1) Recursive Descent Parser & AST Security Policy Validator</div>
        </div>
        <div class="header-actions">
            <button class="ai-tutor-btn" id="open-tutor">🤖 Ask Live Gemini AI Tutor</button>
            <div class="badge safe">System Online</div>
        </div>
    </header>

    <div class="grid-container">
        <div>
            <div class="card">
                <h2>💬 Natural Language Query Input</h2>
                <div class="preset-buttons">
                    <button class="preset-btn" data-query="Show all active employees">1. Safe Select</button>
                    <button class="preset-btn" data-query="Find products with price greater than 500">2. Custom Safe</button>
                    <button class="preset-btn" data-query="Show users where id = 1 or 1=1">3. SQL Injection</button>
                    <button class="preset-btn" data-query="Drop table employees">4. Drop Table</button>
                    <button class="preset-btn" data-query="Update users set role = admin">5. Privilege Escalation</button>
                    <button class="preset-btn" data-query="Show users union select credit_cards">6. Union Injection</button>
                </div>
                <textarea id="user-query">Show all active employees</textarea>
                <button class="primary-btn" id="execute-btn">⚡ Execute Pipeline Analysis</button>
            </div>

            <div class="card">
                <h2>⚙️ Pipeline Execution Trace</h2>
                <div class="results-box" id="trace-output">
                    Click 'Execute Pipeline Analysis' to start trace...
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <h2>🌳 Abstract Syntax Tree (AST) Visualizer [Fully Dynamic]</h2>
                <div id="ast-tree-container">
                    <div style="color: var(--text-muted); font-size: 13px;">AST will render dynamically based on your query...</div>
                </div>
            </div>

            <div class="card">
                <h2>🛡️ Security Policy Validation Audit</h2>
                <div id="security-audit-box" style="font-size: 12px; color: var(--text-muted);">
                    Waiting for validation check...
                </div>
            </div>
        </div>
    </div>

    <!-- AI Tutor Modal -->
    <div id="tutor-modal">
        <div class="modal-content">
            <span class="close-btn" id="close-tutor">&times;</span>
            <h2 style="margin-bottom: 15px;">🤖 Live Gemini AI Compiler Tutor</h2>
            <div class="chat-box" id="chat-messages">
                <div class="chat-msg ai">Hello! I am your live Gemini AI tutor. Ask me anything about parsing or AST validation!</div>
            </div>
            <div style="display: flex; gap: 8px;">
                <input type="text" id="chat-input" placeholder="Ask a concept question..." style="margin-bottom:0;">
                <button class="primary-btn" id="send-chat" style="width: auto;">Send</button>
            </div>
        </div>
    </div>

    <script>
        let lastExecutedState = {
            query: "",
            sql: "",
            isUnsafe: false,
            threatCategory: "",
            rootNodeType: "",
            table: ""
        };

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('user-query').value = btn.getAttribute('data-query');
                });
            });

            document.getElementById('open-tutor').addEventListener('click', () => {
                document.getElementById('tutor-modal').style.display = 'flex';
            });
            document.getElementById('close-tutor').addEventListener('click', () => {
                document.getElementById('tutor-modal').style.display = 'none';
            });

            document.getElementById('execute-btn').addEventListener('click', runPipeline);
            document.getElementById('send-chat').addEventListener('click', sendChatMessage);
            document.getElementById('chat-input').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') sendChatMessage();
            });
        });

        function runPipeline() {
            const prompt = document.getElementById('user-query').value.trim();
            const traceBox = document.getElementById('trace-output');
            const astContainer = document.getElementById('ast-tree-container');
            const auditBox = document.getElementById('security-audit-box');

            if (!prompt) {
                alert("Please enter a query!");
                return;
            }

            const lower = prompt.toLowerCase();
            let sql = "";
            let isUnsafe = false;
            let threatCategory = "";
            let explanation = "";
            let rootNodeType = "SelectStatement";
            let table = "database_records";
            let condition = "general_filter = true";
            let projection = "*";

            if (lower.includes("product")) table = "products_catalog";
            else if (lower.includes("employee")) table = "employees_db";
            else if (lower.includes("user")) table = "users_accounts";
            else if (lower.includes("order")) table = "customer_orders";

            if (lower.includes("price")) condition = "price > 500";
            else if (lower.includes("active")) condition = "status = 'active'";
            else if (lower.includes("department")) condition = "department = 'HR'";
            else if (lower.includes("join")) condition = "joined_date > '2023-01-01'";

            if (lower.includes("drop")) {
                sql = `DROP TABLE ${table};`;
                isUnsafe = true;
                rootNodeType = "DropTableStatement [DDL]";
                threatCategory = "Destructive Schema Modification (DROP)";
                explanation = `The Top-Down Parser detected a DDL command node. Our security policy strictly permits read-only DML queries. Dropping table '${table}' violates structural integrity rules.`;
            } else if (lower.includes("delete")) {
                sql = `DELETE FROM ${table} WHERE 1=1;`;
                isUnsafe = true;
                rootNodeType = "DeleteStatement [DML Mutative]";
                threatCategory = "Destructive Data Deletion (DELETE)";
                explanation = `An unauthorized mutation node (DeleteStatement) was instantiated during recursive descent parsing. The policy engine blocked execution to prevent data loss on table '${table}'.`;
            } else if (lower.includes("update") || lower.includes("role")) {
                sql = `UPDATE ${table} SET role = 'admin';`;
                isUnsafe = true;
                rootNodeType = "UpdateStatement [Privilege Escalation]";
                threatCategory = "Unauthorized Privilege Escalation (UPDATE)";
                explanation = `AST analysis revealed an UpdateStatement node modifying table '${table}'. This violates the principle of least privilege enforced by the security validator.`;
            } else if (lower.includes("union")) {
                sql = `SELECT * FROM ${table} UNION SELECT credit_card FROM admin_vault;`;
                isUnsafe = true;
                rootNodeType = "SelectStatement [Union Exfiltration]";
                threatCategory = "Union-Based Data Exfiltration";
                explanation = `The parser detected a secondary SELECT sub-tree combined via a UNION operator node. This is a classic data leakage pattern targeting sensitive foreign tables.`;
            } else if (lower.includes("or 1=1") || lower.includes("1=1") || lower.includes("or 'a'='a'")) {
                sql = `SELECT * FROM ${table} WHERE id = 1 OR 1=1;`;
                isUnsafe = true;
                rootNodeType = "SelectStatement [Logical Tautology]";
                threatCategory = "SQL Injection / Tautology Attack";
                explanation = `AST inspection of the WHERE clause identified a non-deterministic LogicalExpression (OR 1=1). This always-true condition bypasses authentication checks and was flagged as malicious.`;
            } else {
                sql = `SELECT ${projection} FROM ${table} WHERE ${condition};`;
                isUnsafe = false;
                rootNodeType = "SelectStatement [Read-Only DML]";
                explanation = `The AST consists solely of safe traversal nodes (Projection, TableSource, and Deterministic Condition). Verified against read-only security compliance rules.`;
            }

            lastExecutedState = {
                query: prompt,
                sql: sql,
                isUnsafe: isUnsafe,
                threatCategory: threatCategory,
                rootNodeType: rootNodeType,
                table: table
            };

            traceBox.innerHTML = `[1] User Input: "${prompt}"\n[2] LLM Text-to-SQL: "${sql}"\n[3] LL(1) Parser: Left-to-right token stream processed.\n[4] AST Root Node: <${rootNodeType}> constructed.`;

            if (isUnsafe) {
                auditBox.innerHTML = `
                    <div class="badge danger" style="margin-bottom: 8px;">SECURITY ALERT: QUERY BLOCKED</div>
                    <p style="color: #f87171; margin-bottom: 4px;"><b>Threat Type:</b> ${threatCategory}</p>
                    <p style="color: var(--text-muted); line-height: 1.4;"><b>AST Policy Audit:</b> ${explanation}</p>
                `;

                astContainer.innerHTML = `
                    <div class="ast-node danger">Root: ${rootNodeType}</div>
                    <div class="ast-connector"></div>
                    <div class="ast-node danger">Target: ${table}</div>
                    <div class="ast-connector"></div>
                    <div class="ast-node danger" style="font-size: 10px;">🛑 Violation Node Flagged & Rejected</div>
                `;
            } else {
                auditBox.innerHTML = `
                    <div class="badge safe" style="margin-bottom: 8px;">AUDIT PASSED: SAFE EXECUTION</div>
                    <p style="color: #34d399; margin-bottom: 4px;"><b>Status:</b> Read-Only Query Verified</p>
                    <p style="color: var(--text-muted); line-height: 1.4;"><b>AST Policy Audit:</b> ${explanation}</p>
                `;

                astContainer.innerHTML = `
                    <div class="ast-node">Root: ${rootNodeType}</div>
                    <div class="ast-connector"></div>
                    <div class="ast-row">
                        <div class="ast-node" style="font-size: 10px;">Projection: ${projection}</div>
                        <div class="ast-node" style="font-size: 10px;">Source: ${table}</div>
                        <div class="ast-node" style="font-size: 10px;">Predicate: ${condition}</div>
                    </div>
                    <div class="ast-connector" style="margin-top: 4px;"></div>
                    <div class="ast-node" style="background: #0f172a; border-color: #38bdf8; font-size: 10px; color: #38bdf8;">
                        ✓ AST Node Hierarchy Checked & Cleared
                    </div>
                `;
            }
        }

        async function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const chatBox = document.getElementById('chat-messages');
            const text = input.value.trim();
            if(!text) return;

            chatBox.innerHTML += `<div class="chat-msg user">${text}</div>`;
            input.value = "";
            chatBox.scrollTop = chatBox.scrollHeight;

            const loadingId = "loading-" + Date.now();
            chatBox.innerHTML += `<div class="chat-msg ai" id="${loadingId}">Thinking with Gemini AI...</div>`;
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        state: lastExecutedState
                    })
                });

                const data = await response.json();
                document.getElementById(loadingId).remove();

                if (data.reply) {
                    chatBox.innerHTML += `<div class="chat-msg ai">${data.reply}</div>`;
                } else {
                    chatBox.innerHTML += `<div class="chat-msg ai">Sorry, error connecting to Gemini AI.</div>`;
                }
            } catch (error) {
                document.getElementById(loadingId).remove();
                chatBox.innerHTML += `<div class="chat-msg ai">Network error connecting to backend API.</div>`;
            }
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
</body>
</html>
